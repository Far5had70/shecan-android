<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/homeBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include
            android:id="@+id/toolbar"
            layout="@layout/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <ir.shecan.ui.widget.ProfileTabBar
            android:id="@+id/profileTabBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/profileTab"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="16dp"
                    android:background="@drawable/profile_rounded_box"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/profileView"
                        layout="@layout/layout_profile_header"
                        android:layout_width="170dp"
                        android:layout_height="170dp"
                        android:layout_gravity="center_horizontal" />

                    <EditText
                        android:id="@+id/edtPersianName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginVertical="12dp"
                        android:background="@drawable/edittext_profile_rounded_box"
                        android:fontFamily="@font/iran_yekan_light"
                        android:gravity="start"
                        android:hint="@string/persianName"
                        android:padding="14dp"
                        android:textColor="@color/greenPrimaryTextColor"
                        android:textColorHint="@color/greenPrimaryTextColor"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/edtPersianFamilyName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginVertical="12dp"
                        android:background="@drawable/edittext_profile_rounded_box"
                        android:fontFamily="@font/iran_yekan_light"
                        android:gravity="start"
                        android:hint="@string/persianFamilyName"
                        android:padding="14dp"
                        android:textColor="@color/greenPrimaryTextColor"
                        android:textColorHint="@color/greenPrimaryTextColor"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/edtEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginVertical="12dp"
                        android:background="@drawable/edittext_profile_rounded_box"
                        android:fontFamily="@font/iran_yekan_light"
                        android:gravity="start"
                        android:hint="@string/email"
                        android:inputType="textEmailAddress"
                        android:padding="14dp"
                        android:textColor="@color/greenPrimaryTextColor"
                        android:textColorHint="@color/greenPrimaryTextColor"
                        android:textSize="14sp" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/passwordTab"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="16dp"
                    android:background="@drawable/profile_rounded_box"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/oldPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginVertical="12dp"
                        android:background="@drawable/edittext_profile_rounded_box"
                        android:fontFamily="@font/iran_yekan_light"
                        android:gravity="end"
                        android:hint="@string/password"
                        android:inputType="textPassword"
                        android:padding="14dp"
                        android:textColor="@color/greenPrimaryTextColor"
                        android:textColorHint="@color/greenPrimaryTextColor"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/edtPasswordNew"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginVertical="12dp"
                        android:background="@drawable/edittext_profile_rounded_box"
                        android:fontFamily="@font/iran_yekan_light"
                        android:gravity="end"
                        android:hint="@string/passwordNew"
                        android:inputType="textPassword"
                        android:padding="14dp"
                        android:textColor="@color/greenPrimaryTextColor"
                        android:textColorHint="@color/greenPrimaryTextColor"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/edtPasswordNewRepeat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginVertical="12dp"
                        android:background="@drawable/edittext_profile_rounded_box"
                        android:fontFamily="@font/iran_yekan_light"
                        android:gravity="end"
                        android:hint="@string/passwordNewRepeat"
                        android:inputType="textPassword"
                        android:padding="14dp"
                        android:textColor="@color/greenPrimaryTextColor"
                        android:textColorHint="@color/greenPrimaryTextColor"
                        android:textSize="14sp" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp" />

                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_gravity="bottom"
        android:background="@color/homeBackground"
        android:orientation="horizontal"
        android:weightSum="10">

        <ir.shecan.ui.widget.CustomButton
            android:id="@+id/btnSave"
            style="@style/CustomButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:layout_weight="8"
            android:text="@string/saveChange" />

        <ir.shecan.ui.widget.CustomButton
            android:id="@+id/btnCancel"
            style="@style/CustomButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:layout_weight="2"
            android:text="@string/cancel"
            app:type="secondary" />

        <!--        <com.google.android.material.button.MaterialButton-->
        <!--            android:id="@+id/btnLogin"-->
        <!--            android:layout_width="0dp"-->
        <!--            android:layout_weight="2"-->
        <!--            android:layout_height="wrap_content"-->
        <!--            style="@style/ButtonPrimary"-->
        <!--            android:layout_marginHorizontal="8dp"-->
        <!--            android:backgroundTint="@color/greenMain"-->
        <!--            android:text="@string/saveChange"-->
        <!--            android:textColor="#FFFFFF"/>-->

        <!--        <com.google.android.material.button.MaterialButton-->
        <!--            android:id="@+id/btnCancel"-->
        <!--            android:layout_width="0dp"-->
        <!--            android:layout_weight="1"-->
        <!--            android:layout_height="wrap_content"-->
        <!--            style="@style/ButtonSecondary"-->
        <!--            android:layout_marginHorizontal="8dp"-->
        <!--            android:backgroundTint="@color/homeBackground"-->
        <!--            android:text="@string/cancel2"-->
        <!--            android:textColor="@color/greenSecondaryTextColor"/>-->

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/greenMain"
        android:indeterminateTintMode="src_in"
        android:visibility="gone" />

</FrameLayout>
