<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="ltr"
    app:cardCornerRadius="24dp"
    app:cardElevation="12dp"
    app:cardUseCompatPadding="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rootPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_service_panel"
        android:padding="15dp"
        android:clipToPadding="false">

        <FrameLayout
            android:id="@+id/iconWrap"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_icon_square"
            android:foregroundGravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivOpen"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="open"
                android:src="@drawable/ic_open" />
        </FrameLayout>

        <!-- سه ستون متن: هر ستون شامل label کوچک (بالا) و مقدار (پایین) -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/g1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.45" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/g2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.70" />

        <!-- ستون اول: کد سفارش -->
        <LinearLayout
            android:id="@+id/colOrder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/g2"
            app:layout_constraintStart_toStartOf="@id/g1"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/labelOrder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/orderNo"
                android:textColor="@color/selectedConfigTitleTextColor"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/valueOrder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/selectedConfigBodyTextColor"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="۲۹۳۲۸۶۴" />
        </LinearLayout>

        <!-- ستون دوم: نوع سرویس -->
        <LinearLayout
            android:id="@+id/colService"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/g2"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/labelService"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/serviceType"
                android:textColor="@color/selectedConfigTitleTextColor"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/valueService"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/selectedConfigBodyTextColor"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="برنزی" />
        </LinearLayout>

        <!-- ستون سوم: تاریخ انقضا -->
        <LinearLayout
            android:id="@+id/colExpire"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/g1"
            app:layout_constraintStart_toEndOf="@id/iconWrap"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/labelExpire"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/expire_date"
                android:textColor="@color/selectedConfigTitleTextColor"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/valueExpire"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/selectedConfigBodyTextColor"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="۱۴۰۴/۰۶/۲۸" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>