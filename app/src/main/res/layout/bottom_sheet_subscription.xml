<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="20dp"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:background="@color/lightBack">

    <!-- header row: support button, status chip, chevron -->
    <LinearLayout
        android:id="@+id/headerRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_config_detail">

            <TextView
                android:id="@+id/btnSupport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingVertical="3dp"
                android:paddingHorizontal="8dp"
                android:textColor="@color/primaryTextColor"
                android:text="پشتیبانی"
                />

        </FrameLayout>

        <FrameLayout android:layout_width="8dp" android:layout_height="0dp" />

        <LinearLayout
            android:id="@+id/statusBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:padding="4dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_status_box">

            <ImageView
                android:id="@+id/statusBoxIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_alert" />

            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="در حال انقضا..."
                android:textStyle="bold"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#EE5F1D"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/ivChevron"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="4dp"
            android:src="@drawable/ic_chevron_bottom"
            android:contentDescription=""
            app:tint="@color/primaryTextColor" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/cardInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/headerRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

               <LinearLayout
                   android:layout_width="0dp"
                   android:layout_height="wrap_content"
                   android:layout_weight="1"
                   android:gravity="center"
                   android:orientation="vertical">

                   <TextView
                       android:id="@+id/tvOrderCode"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:text="کد سفارش"
                       android:textSize="13sp"
                       android:textColor="@color/greenSecondaryTextColor" />

                   <FrameLayout android:layout_width="8dp" android:layout_height="8dp" />

                   <TextView
                       android:id="@+id/tvOrderCodeBody"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:text="321311"
                       android:textSize="13sp"
                       android:textStyle="bold"
                       android:textColor="@color/primaryTextColor" />

               </LinearLayout>

               <LinearLayout
                   android:layout_width="0dp"
                   android:layout_height="wrap_content"
                   android:layout_weight="1"
                   android:gravity="center"
                   android:orientation="vertical">

                   <TextView
                       android:id="@+id/tvServiceType"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:text="نوع سرویس"
                       android:textSize="13sp"
                       android:textColor="@color/greenSecondaryTextColor" />

                   <FrameLayout android:layout_width="8dp" android:layout_height="8dp" />

                   <TextView
                       android:id="@+id/tvServiceTypeBody"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:text="برنزی"
                       android:textSize="13sp"
                       android:textStyle="bold"
                       android:textColor="@color/primaryTextColor" />

               </LinearLayout>

               <LinearLayout
                   android:layout_width="0dp"
                   android:layout_height="wrap_content"
                   android:layout_weight="1"
                   android:gravity="center"
                   android:orientation="vertical">

                   <TextView
                       android:id="@+id/tvCompanyName"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:text="نام شرکت"
                       android:textSize="13sp"
                       android:textColor="@color/greenSecondaryTextColor" />

                   <FrameLayout android:layout_width="8dp" android:layout_height="8dp" />

                   <TextView
                       android:id="@+id/tvCompanyNameBody"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:text="-"
                       android:textSize="13sp"
                       android:textStyle="bold"
                       android:textColor="@color/primaryTextColor" />

               </LinearLayout>

            </LinearLayout>

            <!-- second row: dates -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPayCycleLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="دوره پرداخت"
                        android:textSize="12sp"
                        android:textColor="@color/greenSecondaryTextColor" />

                    <FrameLayout android:layout_width="8dp" android:layout_height="8dp" />

                    <TextView
                        android:id="@+id/tvPayCycleBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ماهانه"
                        android:textSize="13sp"
                        android:textColor="@color/primaryTextColor" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStartDateLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="تاریخ شروع"
                        android:textSize="12sp"
                        android:textColor="@color/greenSecondaryTextColor" />

                    <FrameLayout android:layout_width="8dp" android:layout_height="8dp" />

                    <TextView
                        android:id="@+id/tvStartDateBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1404/05/28"
                        android:textSize="13sp"
                        android:textColor="@color/primaryTextColor" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvEndDateLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="تاریخ انقضا"
                        android:textSize="12sp"
                        android:textColor="@color/primaryTextColor" />

                    <FrameLayout android:layout_width="8dp" android:layout_height="8dp" />

                    <TextView
                        android:id="@+id/tvEndDateBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1404/06/28"
                        android:textSize="13sp"
                        android:textColor="@color/primaryTextColor" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

    <!-- remaining time card (contains circular progress include + text + button) -->
    <LinearLayout
        android:id="@+id/cardRemaining"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_round_button"
        app:layout_constraintTop_toBottomOf="@id/cardInfo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <!-- left: texts -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:gravity="center"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRemainingDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="۲۲ روز از سرویست مونده. می‌تونی برای مدت بیشتر رزرو کنی."
                    android:textSize="14sp"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/greenSecondaryTextColor" />

                <Button
                    android:id="@+id/btnRenew"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="تمدید سرویس"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:background="@drawable/btn_orange_rounded"
                    android:textColor="#FFFFFF"
                    android:textAllCaps="false" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/remainingTimeTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="زمان باقی‌مانده"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/primaryTextColor" />

                <ir.shecan.widget.CircularGlowProgressBar
                    android:id="@+id/customProgress"
                    android:layout_width="120dp"
                    android:layout_height="120dp"/>

                <TextView
                    android:id="@+id/remainingTimeBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="22d 1h 23m"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/primaryTextColor" />


            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- footer: small draggable indicator and settings label -->
<!--    <TextView-->
<!--        android:id="@+id/tvSettings"-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:layout_marginTop="14dp"-->
<!--        android:gravity="center"-->
<!--        android:text="تنظیمات دستی"-->
<!--        android:textSize="13sp"-->
<!--        android:textColor="@color/serviceRowBodyColor"-->
<!--        app:layout_constraintTop_toBottomOf="@id/cardRemaining"-->
<!--        app:layout_constraintStart_toStartOf="parent"-->
<!--        app:layout_constraintEnd_toEndOf="parent" />-->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCustomConfig"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/secondaryButtonColor"
        android:layout_marginTop="16dp"
        android:text="تنظیمات دستی"
        android:textAllCaps="false"
        android:textColor="@color/primaryTextColor"
        android:textSize="14sp"
        android:textStyle="bold"
        app:icon="@drawable/ic_chevron_top"
        app:iconGravity="textStart"
        app:iconSize="24dp"
        app:iconTint="@color/primaryTextColor"
        app:layout_constraintTop_toBottomOf="@id/cardRemaining"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>